<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.TmdbSyncActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="@string/tmdb_sync_title"
            app:layout_scrollFlags="noScroll"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxRatings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_sync_ratings"
                android:checked="true"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_sync_favorites"
                android:checked="true"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxWatchlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_sync_watchlist"
                android:checked="true"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxLists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_sync_lists"
                android:checked="true"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxLocalLists"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_sync_local_lists"
                android:checked="true"/>

            <TextView
                android:id="@+id/textViewListSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_sync_list_selection"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxDryRun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tmdb_sync_dry_run"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/tmdb_sync_start"/>

            <TextView
                android:id="@+id/textViewSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
