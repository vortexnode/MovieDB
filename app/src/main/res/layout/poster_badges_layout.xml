<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_gravity="bottom|end"
    android:padding="4dp"
    android:gravity="center_vertical|end"
    android:id="@+id/posterBadgesContainer"
    android:visibility="gone">

    <TextView
        android:id="@+id/badgeYourRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_pill_background"
        android:backgroundTint="#3F51B5"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginEnd="2dp"
        android:visibility="gone"
        android:text="9" />

    <ImageView
        android:id="@+id/badgeLists"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_list"
        android:background="@drawable/badge_circle_background"
        android:backgroundTint="#9C27B0"
        android:padding="3dp"
        app:tint="@android:color/white"
        android:layout_marginEnd="2dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/badgeCollection"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_collection"
        android:background="@drawable/badge_circle_background"
        android:backgroundTint="#009688"
        android:padding="3dp"
        app:tint="@android:color/white"
        android:layout_marginEnd="2dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/badgeFavorites"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_favorite"
        android:background="@drawable/badge_circle_background"
        android:backgroundTint="#F44336"
        android:padding="3dp"
        app:tint="@android:color/white"
        android:layout_marginEnd="2dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/badgeWillWatch"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_bookmark"
        android:background="@drawable/badge_circle_background"
        android:backgroundTint="#2196F3"
        android:padding="3dp"
        app:tint="@android:color/white"
        android:layout_marginEnd="2dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/badgeWatched"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_check"
        android:background="@drawable/badge_circle_background"
        android:backgroundTint="#4CAF50"
        android:padding="3dp"
        app:tint="@android:color/white"
        android:visibility="gone" />
</LinearLayout>
